# Entornos virtuales
.venv/
venv/
env/
.lab01/

# Python, pruebas y empaquetado
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/
*.egg-info/

# Formatos de datos y modelos, también fuera de los directorios de artefactos
*.csv
*.parquet
*.pickle
*.pkl
*.joblib

# Permitir archivos de ejemplo y pruebas versionables en sus directorios
!/config/**/*.csv
!/config/**/*.parquet
!/config/**/*.pickle
!/config/**/*.pkl
!/config/**/*.joblib
!/tests/**/*.csv
!/tests/**/*.parquet
!/tests/**/*.pickle
!/tests/**/*.pkl
!/tests/**/*.joblib

# Archivos locales, temporales y secretos
.aws/
.env
.env.*
!.env.example
*.local
*.local.*
/config/secrets.yaml
/config/secrets.yml
credentials.json
credentials.yaml
credentials.yml
*credentials*.local.*
service-account*.json
service_account*.json
*.pem
*.key
*.p8
*.p12
*.pfx
*.ppk
id_rsa
id_ed25519
id_ecdsa
id_dsa
/.dvc/config.local
*.swp
*.swo
*~
.DS_Store
/tmp/

# Logs
*.log
/logs/
/airflow/state/
/airflow/logs/

# Datos, modelos y resultados generados. Los metadatos DVC sí se versionan.
/data/**
!/data/**/
!/data/**/.gitkeep
!/data/**/*.dvc
/models/**
!/models/**/
!/models/**/.gitkeep
!/models/**/*.dvc
/reports/**
!/reports/**/
!/reports/**/.gitkeep
!/reports/**/*.dvc
